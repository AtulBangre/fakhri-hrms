# ---------------------------------------------------------------------------
# Fakhri HRMS configuration. Copy to `.env` and edit.
# Every value can also be supplied as a plain environment variable (Docker,
# systemd, Kubernetes).
# ---------------------------------------------------------------------------

# --- organisation ----------------------------------------------------------
HRMS_PUBLIC_BASE_URL=http://127.0.0.1:8100
HRMS_TZ=Asia/Kolkata
HRMS_LOG_LEVEL=INFO
# Interactive API docs at /api/docs (off by default in production)
HRMS_API_DOCS=0
HRMS_DATA_DIR=./data

# --- the Face API service this HRMS uses for detection + matching ----------
# Point this at the `faceapi` project (see ../faceapi/README.md).
HRMS_FACEAPI_URL=http://127.0.0.1:8000
# Only needed when the Face API runs with FACEAPI_AUTH_ENABLED=true.
# Create one with:  cd ../faceapi && ./.venv/bin/python3 cli.py keys create --name hrms --plan personal
HRMS_FACEAPI_KEY=
HRMS_FACE_COLLECTION=employees
HRMS_FACE_TIMEOUT=20
# true = the kiosk refuses to scan when the face service is down
HRMS_FACE_REQUIRED=false

# --- sessions and security -------------------------------------------------
# Leave empty to auto-generate and store in data/secret_key.txt.
# In production set it explicitly: openssl rand -base64 48
HRMS_SECRET_KEY=
HRMS_SESSION_HOURS=12
HRMS_KIOSK_SESSION_DAYS=30
# Set true when serving over HTTPS (recommended) so cookies are Secure-only.
HRMS_SECURE_COOKIES=false

# --- email (SMTP) ----------------------------------------------------------
# Leave SMTP_HOST empty to use the console driver: every email is written to
# data/outbox/*.eml instead of being delivered. Good for demos and testing.
# For Gmail use an App Password, not your normal password.
HRMS_SMTP_HOST=
HRMS_SMTP_PORT=587
HRMS_SMTP_TLS=starttls          # starttls | ssl | none
HRMS_SMTP_USER=
HRMS_SMTP_PASSWORD=
# Falls back to the SMTP user when empty.
HRMS_SMTP_FROM=
HRMS_NOTIFY_EMAIL=true          # master switch for outbound email

# --- WhatsApp / SMS --------------------------------------------------------
# console (writes to data/outbox) | twilio | meta (meta = WhatsApp only)
HRMS_WHATSAPP_PROVIDER=console
HRMS_SMS_PROVIDER=console
HRMS_TWILIO_ACCOUNT_SID=
HRMS_TWILIO_AUTH_TOKEN=
HRMS_TWILIO_FROM=               # +1415... (your Twilio number)
HRMS_META_PHONE_ID=             # WhatsApp Cloud API phone number id
HRMS_META_TOKEN=

# --- automatic messages ----------------------------------------------------
HRMS_NOTIFY_PUNCH_IN=true       # email "attendance marked IN/OUT"
HRMS_NOTIFY_LATE=true           # extra alert when someone is late
HRMS_NOTIFY_LEAVE=true          # HR on request, employee on decision
HRMS_NOTIFY_WHATSAPP_ATTENDANCE=false
HRMS_NOTIFY_INTERVAL=20         # seconds between outbox drains

# --- self-service password reset -------------------------------------------
HRMS_OTP_TTL_MINUTES=10
HRMS_OTP_MAX_ATTEMPTS=5
HRMS_OTP_COOLDOWN=60

# --- first run -------------------------------------------------------------
# The HR login always gets created; give it a password here, or leave empty and
# a random one is written to data/initial_credentials.txt.
HRMS_DEFAULT_HR_USER=hr
HRMS_DEFAULT_HR_PASSWORD=
# The gate login. Give it a password here for a predictable first run, or leave
# empty and a random one is written to data/initial_credentials.txt.
HRMS_DEFAULT_KIOSK_USER=gate
HRMS_DEFAULT_KIOSK_PASSWORD=

# --- kiosk behaviour -------------------------------------------------------
# Scans from the same face inside this many seconds are ignored (anti double-tap
# and anti queue-abuse).
HRMS_KIOSK_DEBOUNCE=45

# Show the employee's name on the gate screen after a successful scan.
# false (default) keeps the shared screen anonymous: nobody in the queue sees
# whose attendance was just marked. Turn it on only if gate staff need it to
# verify that the right person was matched.
HRMS_KIOSK_SHOW_NAME=false

# ---------------------------------------------------------------------------
# Docker-only knobs (read by docker-entrypoint.sh)
# ---------------------------------------------------------------------------
PORT=8100
WORKERS=1
